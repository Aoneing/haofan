/* 配图管理 */
.gal-sum {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}
.gal-sum__num {
  font-size: 44rpx;
  font-weight: 700;
  color: #3b3aae;
  margin-right: 12rpx;
}

.gal-alert {
  margin-top: 16rpx;
  margin-bottom: 0;
  line-height: 1.7;
}

.gal-row {
  display: flex;
  align-items: flex-start;
}

.gal-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f2f2f4;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gal-thumb__img {
  width: 120rpx;
  height: 120rpx;
}
.gal-thumb--empty {
  background: #e9f94e;
}
.gal-thumb__ph {
  font-size: 44rpx;
  font-weight: 700;
  color: #0e0e10;
}

.gal-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  margin-right: 12rpx;
}
.gal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0e0e10;
  word-break: break-all;
  line-height: 1.4;
}
.gal-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.gal-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.gal-badge--ok {
  background: #d8f5e9;
  color: #1f6b4d;
}
.gal-badge--busy {
  background: #fff7d6;
  color: #7a5b00;
}
.gal-badge--bad {
  background: #fdeceb;
  color: #b3261e;
}
.gal-badge--idle {
  background: #f2f2f4;
  color: #8b8c93;
}

.gal-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b8c93;
}
/* 重复提交是这个页面最该被看见的信息，用告警色 + 加粗 */
.gal-count--warn {
  color: #b3261e;
  font-weight: 700;
}

.gal-err {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #b3261e;
  word-break: break-all;
}

.gal-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #b3261e;
  padding: 8rpx 4rpx 8rpx 12rpx;
}
.gal-del--busy {
  color: #8b8c93;
}

.gal-foot {
  margin-top: 8rpx;
  line-height: 1.7;
}