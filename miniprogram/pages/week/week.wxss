.week-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}
.week-header__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d332b;
}

.state-card {
  text-align: center;
  padding: 64rpx 40rpx;
}
.state-card__emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-card .muted {
  display: block;
}

/* 星期导航：白底圆角容器 + 选中纯色方块（无线条） */
.week-nav {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 14rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(122, 96, 66, 0.06);
}
.week-nav__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 12rpx;
  border-radius: 16rpx;
  transition: background 0.2s;
}
.week-nav__item--on {
  background: #b26a00;
  box-shadow: 0 6rpx 16rpx rgba(178, 106, 0, 0.28);
}
.week-nav__wd {
  font-size: 26rpx;
  font-weight: 600;
  color: #7a6a55;
}
.week-nav__date {
  font-size: 22rpx;
  color: #9a8f80;
  margin-top: 4rpx;
}
.week-nav__item--on .week-nav__wd,
.week-nav__item--on .week-nav__date {
  color: #ffffff;
}
/* 今天未被选中时，星期字用品牌橙提示 */
.week-nav__item--today .week-nav__wd {
  color: #b26a00;
}
