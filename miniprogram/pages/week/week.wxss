/* 一周页：日期条 + hero + 两列色卡（与今日页共用一套卡片语言） */

.hero {
  display: flex;
  align-items: center;
  background: #3b3aae;
  border-radius: 40rpx;
  padding: 40rpx;
  margin: 24rpx 0 32rpx;
}
.hero__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.hero__date {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.5rpx;
}
/* 一周页的「今天」在日期左边（今日页在右边）：两页徽标位置不同是有意的，
   今日页那天只有一个候选、一周页要靠徽标在日期旁做「当前」提示 */
.hero__badge--light {
  flex-shrink: 0;
  margin-right: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0e0e10;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.hero__mascot {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  margin-left: 24rpx;
  border-radius: 50%;
}

/* 日期条：白底胶囊，7 格均分 */
.dbar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(14, 14, 16, 0.05);
}
.dbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dbar__wd {
  font-size: 22rpx;
  color: #8b8c93;
  line-height: 1.2;
}
.dbar__num-wrap {
  margin-top: 10rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
}
.dbar__num {
  font-size: 28rpx;
  font-weight: 600;
  color: #0e0e10;
}
.dbar__num--on {
  color: #ffffff;
}
/* 选中项：黑色圆 */
.dbar__pill {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #0e0e10;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 两列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.grid__cell {
  width: 50%;
  box-sizing: border-box;
  padding: 0 10rpx;
}

.prepbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f2f4;
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  margin-top: 20rpx;
}
.prepbar:active {
  opacity: 0.7;
}
.prepbar__text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #0e0e10;
}
.prepbar__count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #55565c;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.state-card {
  text-align: center;
  padding: 72rpx 40rpx;
}
.state-card__emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-card .muted {
  display: block;
}