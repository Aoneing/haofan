/* 一周页：日期条 + 两列色卡（与今日页共用一套卡片语言） */

/* 日期条：白底胶囊，7 格均分 */
.dbar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(14, 14, 16, 0.05);
}
.dbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dbar__wd {
  font-size: 22rpx;
  color: #8b8c93;
  line-height: 1.2;
}
.dbar__num-wrap {
  margin-top: 10rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
}
.dbar__num {
  font-size: 28rpx;
  font-weight: 600;
  color: #0e0e10;
}
.dbar__num--on {
  color: #ffffff;
}
/* 选中项：黑色圆 */
.dbar__pill {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #0e0e10;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 两列网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.grid__cell {
  width: 50%;
  box-sizing: border-box;
  padding: 0 10rpx;
}

/* 备料卡（prep-card 组件）已接管早/晚/整周备料的展示，这里不再保留汇总条样式 */

.state-card {
  text-align: center;
  padding: 72rpx 40rpx;
}
.state-card__emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-card .muted {
  display: block;
}