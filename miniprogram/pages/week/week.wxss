.week-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}
.week-header__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d332b;
}

.state-card {
  text-align: center;
  padding: 64rpx 40rpx;
}
.state-card__emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-card .muted {
  display: block;
}

/* 吸顶容器：当前日期小字 + 星期导航，滚动时一直贴在顶部不消失
   背景用页面底色，遮住下方滚过的卡片 */
.wk-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #fff8ef;
  padding-bottom: 4rpx;
  transition: box-shadow 0.2s ease;
}
.wk-sticky--pinned {
  box-shadow: 0 10rpx 20rpx rgba(122, 96, 66, 0.12);
}
.wk-sticky__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx 8rpx;
}
.wk-sticky__day {
  font-size: 24rpx;
  font-weight: 600;
  color: #b26a00;
}
.wk-sticky__range {
  font-size: 22rpx;
  color: #9a8f80;
}

/* 星期导航：白底圆角容器 + 选中纯色方块（无线条）
   只保留周几、去掉日期，整体压扁，尽量少占正文空间 */
.week-nav {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 4rpx 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(122, 96, 66, 0.06);
}
.week-nav__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
  border-radius: 8rpx;
  transition: background 0.2s;
}
.week-nav__item--on {
  background: #b26a00;
  box-shadow: 0 6rpx 16rpx rgba(178, 106, 0, 0.28);
}
.week-nav__wd {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.1;
  color: #7a6a55;
}
.week-nav__item--on .week-nav__wd {
  color: #ffffff;
}
/* 今天未被选中时，星期字用品牌橙提示 */
.week-nav__item--today .week-nav__wd {
  color: #b26a00;
}
