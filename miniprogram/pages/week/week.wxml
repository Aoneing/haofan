<view class="container">
  <view wx:if="{{loading}}" class="center-tip">正在摆桌…</view>

  <block wx:elif="{{notFound}}">
    <view class="card state-card">
      <view class="state-card__emoji">🍽️</view>
      <view class="card-title">还没有食谱</view>
      <view class="muted">把家里那一周食谱 Excel 发给小程序，一键生成</view>
      <button class="btn-primary" style="margin-top:28rpx" bindtap="goImport">去导入</button>
    </view>
  </block>

  <block wx:else>
    <!-- 顶部大标题：随滚动自然上移滚出 -->
    <view class="week-header">
      <view class="week-header__title">本期菜单</view>
      <view class="muted">{{periodRange}}</view>
    </view>

    <!-- 吸顶区：当前日期小字 + 星期导航，滚动时始终常驻顶部不消失 -->
    <view class="wk-sticky {{headerFolded ? 'wk-sticky--pinned' : ''}}">
      <view class="wk-sticky__meta">
        <text class="wk-sticky__day">{{activeDayText}}</text>
        <text class="wk-sticky__range">本期 {{periodRange}}</text>
      </view>

      <view class="week-nav">
        <view
          wx:for="{{navDays}}"
          wx:key="date"
          class="week-nav__item {{index === activeIndex ? 'week-nav__item--on' : ''}} {{item.isToday && index !== activeIndex ? 'week-nav__item--today' : ''}}"
          data-index="{{index}}"
          bindtap="onNavTap"
        >
          <text class="week-nav__wd">{{item.weekdayText}}</text>
        </view>
      </view>
    </view>

    <view wx:for="{{days}}" wx:key="index" id="day-{{index}}">
      <day-card
        day="{{item.day}}"
        images="{{item.images}}"
        compact="{{true}}"
        expandable="{{true}}"
        highlight="{{item.highlight}}"
        bind:daytap="onDayTap"
        bind:dishtap="onDishTap"
        bind:expandchange="onCardExpand"
      />
    </view>
  </block>
</view>
