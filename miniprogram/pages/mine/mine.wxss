.stats-row {
  display: flex;
}
.stats-item {
  flex: 1;
  text-align: center;
}
.stats-item__num {
  font-size: 48rpx;
  font-weight: 700;
  color: #b26a00;
}

.period-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #faf5ea; /* 浅米色块替代分割线 */
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.period-row__text {
  font-size: 28rpx;
  color: #3d332b;
}
.period-row__arrow {
  color: #c9bda9;
  font-size: 32rpx;
}

.about-line {
  margin-bottom: 8rpx;
}
