.stats-row {
  display: flex;
}
.stats-item {
  flex: 1;
  text-align: center;
}
.stats-item__num {
  font-size: 48rpx;
  font-weight: 700;
  color: #b26a00;
}
/* 可点进配图管理的那个：给点触摸反馈，不然看不出它能点 */
.stats-item--link:active {
  opacity: 0.55;
}

/* 标题行右侧挂一个总数：折叠起来的时候，总数还得看得见 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.card-head .card-title {
  margin-bottom: 16rpx;
}
.card-head__count {
  font-size: 24rpx;
  color: #9a8f80;
  flex-shrink: 0;
}

.period-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #faf5ea; /* 浅米色块替代分割线 */
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
/* 正在吃的那一期：加一圈主色描边，不用加高也不用加字 */
.period-row--current {
  background: #fff6e6;
  box-shadow: inset 0 0 0 2rpx #b26a00;
}
.period-row__text {
  font-size: 28rpx;
  color: #3d332b;
}
.period-row__meta {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.period-row__badge {
  font-size: 22rpx;
  color: #9a8f80;
  background: rgba(154, 143, 128, 0.12);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}
.period-row__badge--current {
  color: #fff;
  background: #b26a00;
}
.period-row__arrow {
  color: #c9bda9;
  font-size: 32rpx;
}

/* 展开 / 收起：做成一行可点的文字，不给整块加高度 */
.period-more {
  text-align: center;
  font-size: 26rpx;
  color: #b26a00;
  padding: 12rpx 0 4rpx;
}
.period-more:active {
  opacity: 0.55;
}
.period-note {
  font-size: 22rpx;
  text-align: center;
  margin-top: 8rpx;
}

.about-line {
  margin-bottom: 8rpx;
}

/* ---------- 食材处理手册 ---------- */
.prep-sub {
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.prep-group {
  background: #faf5ea;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.prep-group--open {
  background: #fff6e6;
}

.prep-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}
.prep-head__name {
  font-size: 28rpx;
  color: #3d332b;
  font-weight: 600;
}
.prep-head__arrow {
  color: #c9bda9;
  font-size: 30rpx;
}

.prep-steps {
  padding: 0 24rpx 20rpx;
}

.prep-step {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  border-top: 2rpx solid rgba(201, 189, 169, 0.35);
}
.prep-step__hd {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.prep-step__no {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #b26a00;
  color: #fff;
  font-size: 22rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.prep-step__title {
  font-size: 27rpx;
  color: #b26a00;
  font-weight: 600;
}
.prep-step__text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5a4f45;
}

.prep-source {
  font-size: 22rpx;
  margin-top: 8rpx;
}
