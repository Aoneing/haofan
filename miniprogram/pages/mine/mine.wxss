/* 我的页：统计 hero + 期数列表 + 四色食材手册 */

.hero {
  display: flex;
  align-items: center;
  background: #3b3aae;
  border-radius: 40rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
}
.hero__stats {
  flex: 1;
  min-width: 0;
  display: flex;
}
.stat {
  display: flex;
  flex-direction: column;
}
/* 两个数字用两个颜色（柠檬黄 / 薄荷），避免「4 6」读成一串 */
.stat__num {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.1;
}
.stat__num--lime {
  color: #e9f94e;
}
.stat__num--mint {
  color: #7fe3c4;
}
.stat__label {
  font-size: 22rpx;
  color: #ffffff;
  opacity: 0.85;
  margin-top: 6rpx;
}
.hero__mascot {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

/* 期数列表行 */
.prow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f2f4;
  border-radius: 26rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
}
/* 正在吃的那一期：整行换成柠檬黄，不用描边也不用加高 */
.prow--on {
  background: #e9f94e;
}
.prow__text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0e0e10;
}
.prow__badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #55565c;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.prow__badge--on {
  color: #0e0e10;
  background: #ffffff;
}

.more {
  margin-top: 8rpx;
}
.more-note {
  font-size: 22rpx;
  text-align: center;
  margin-top: 12rpx;
}

.sec-head--gap {
  margin-top: 36rpx;
}

/* 食材处理手册：四色轮转，与菜品色卡同一套色板 */
.grow {
  border-radius: 26rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.prow--t0 {
  background: #f2f2f4;
}
.prow--t1 {
  background: #a9b6f2;
}
.prow--t2 {
  background: #e9f94e;
}
.prow--t3 {
  background: #7c8cd8;
}

.grow__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
}
.grow__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #0e0e10;
}
.grow__caret {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0e0e10;
  opacity: 0.7;
}

.grow__steps {
  padding: 0 30rpx 26rpx;
}
.gstep {
  padding: 18rpx 0;
  border-top: 2rpx solid rgba(14, 14, 16, 0.08);
}
.gstep__hd {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.gstep__no {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #0e0e10;
  color: #ffffff;
  font-size: 20rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.gstep__title {
  font-size: 27rpx;
  font-weight: 700;
  color: #0e0e10;
}
.gstep__text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #1f3a3d;
}

.prep-source {
  font-size: 22rpx;
  margin-top: 12rpx;
}

.tools {
  margin-top: 40rpx;
}
.tools button {
  margin-bottom: 16rpx;
}