<!-- 我的页：统计 hero + 导入过的食谱 + 食材处理手册 -->
<view class="container container--tab">
  <view class="page-head">
    <text class="page-head__title">我的</text>
    <text wx:if="{{currentRange}}" class="page-head__chip">{{currentRange}}</text>
  </view>

  <!-- 顶部一行两卡：左 = 月历热力图，右 = 配图管理入口 -->
  <view class="dash-row">
    <view class="heat">
      <view class="heat__hd">
        <view class="heat__nav" hover-class="heat__nav--press" hover-stay-time="80" bindtap="prevMonth">‹</view>
        <view class="heat__hdmid">
          <text class="heat__title">{{heatTitle}}</text>
          <text class="heat__sub">{{heatTotal}} 次</text>
        </view>
        <view class="heat__nav" hover-class="heat__nav--press" hover-stay-time="80" bindtap="nextMonth">›</view>
      </view>

      <!-- 星期表头：一..日 -->
      <view class="heat__wd">
        <text wx:for="{{WEEK_LABELS}}" wx:key="*this" class="heat__wdcell">{{item}}</text>
      </view>

      <!-- 日期格：**按行渲染**，每行从左到右 1,2,3,4... 顺读（符合日历直觉）
           class 全部由数据层的 c.cls 决定，这里不用 wx:if/wx:else 分支：
           wx:else 一旦被注释或空行隔断就编译失败（wx:if not found）。 -->
      <view class="heat__grid">
        <view wx:for="{{heatRows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri" class="heat__row">
          <view
            wx:for="{{row}}"
            wx:for-item="c"
            wx:key="ci"
            class="heat__cell {{c.cls}}"
          >
            <text wx:if="{{!c.void}}" class="heat__day">{{c.d}}</text>
          </view>
        </view>
      </view>

      <view class="heat__legend">
        <text class="heat__legend__txt">少</text>
        <view class="heat__cell heat__l0"></view>
        <view class="heat__cell heat__l1"></view>
        <view class="heat__cell heat__l2"></view>
        <view class="heat__cell heat__l3"></view>
        <view class="heat__cell heat__l4"></view>
        <text class="heat__legend__txt">多</text>
      </view>
    </view>

    <!-- 配图管理：三层卡（参考图）
         ① __base 底图：品牌紫→亮蓝渐变圆角块
         ② __docs 内容：三张白文件卡错落旋转叠放，露出最近三张 AI 图，底部被前景切掉
         ③ __fg   前景：深墨绿面板，左上圆角台阶，标题区垂直居中 + ··· + 文件数 -->
    <view class="gal-card" hover-class="gal-card--press" hover-stay-time="80" bindtap="goGallery">
      <view class="gal-card__base">
        <view class="gal-card__docs">
          <view
            wx:for="{{recentImgs}}"
            wx:key="key"
            wx:for-index="i"
            class="gal-card__doc {{i === 0 ? 'gal-card__doc--a' : (i === 1 ? 'gal-card__doc--b' : 'gal-card__doc--c')}}"
          >
            <image class="gal-card__docimg" src="{{item.url}}" mode="aspectFill" lazy-load="true" />
            <view class="gal-card__line"></view>
            <view class="gal-card__line gal-card__line--short"></view>
          </view>
          <!-- 一张图都还没生成时也要有「文件」轮廓，不能留一块空底图 -->
          <view wx:if="{{!recentImgs.length}}" class="gal-card__doc gal-card__doc--a gal-card__doc--empty">
            <view class="gal-card__docimg gal-card__docimg--ph"></view>
            <view class="gal-card__line"></view>
            <view class="gal-card__line gal-card__line--short"></view>
          </view>
        </view>
      </view>

      <view class="gal-card__fg">
        <view class="gal-card__head">
          <text class="gal-card__title">配图管理</text>
          <text class="gal-card__dots">···</text>
        </view>
        <!-- 副标题与张数并排一行（同一基线），整行往下挪 -->
        <view class="gal-card__row">
          <text class="gal-card__sub">AI 菜品插图</text>
          <view class="gal-card__foot">
            <view class="gal-card__ico"></view>
            <text class="gal-card__count">{{dishTotal}} 张配图</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{envError}}" class="alert alert--warn">{{envError}}</view>
  <view wx:if="{{dishImageError}}" class="alert alert--warn">{{dishImageError}}</view>

  <!-- 导入过的食谱：默认只露最近 3 期 -->
  <view class="sec-head">
    <text class="sec-head__title">导入过的食谱</text>
    <text wx:if="{{periodTotal}}" class="sec-head__count">共 {{periodTotal}} 期</text>
  </view>
  <view wx:if="{{!periodTotal}}" class="card">
    <view class="muted">还没有导入记录</view>
  </view>
  <block wx:else>
    <!-- 导入过的食谱：扁平时间轴（参考 calendar UI）
         左列 = 起始日大数字 + 月份；中列 = 轴点 + 垂直虚线；右列 = 期卡片 -->
    <scroll-view class="tl" scroll-y>
      <view
        wx:for="{{periodsShown}}"
        wx:for-index="pindex"
        wx:key="_id"
        class="tl__item{{item.isCurrent ? ' prow--on' : ''}}"
        data-id="{{item._id}}"
        bindtap="onPeriodTap"
        hover-class="tl__item--press"
        hover-stay-time="80"
      >
        <view class="tl__date">
          <text class="tl__day">{{item.dayNum}}</text>
          <text class="tl__mon">{{item.monthText}}</text>
        </view>
        <view class="tl__axis">
          <view class="tl__dot"></view>
        </view>
        <view class="tl__card">
          <view class="tl__info">
            <text wx:if="{{item.badgeText}}" class="tl__badge">{{item.badgeText}}</text>
            <text class="tl__range">{{item.rangeText}}</text>
          </view>
          <text class="tl__go">›</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{periodTruncated}}" class="muted more-note">
      仅显示最近 {{periodTotal}} 期，更早的已超出查询上限
    </view>
  </block>

  <!-- 小工具 -->
  <view class="tools">
    <button class="btn-ghost" bindtap="goImport">导入新食谱</button>
    <button class="btn-ghost" bindtap="clearCache">清除配图缓存</button>
  </view>
</view>