<!-- 我的页：统计 hero + 导入过的食谱 + 食材处理手册 -->
<view class="container">
  <view class="page-head">
    <text class="page-head__title">好饭 · 我的</text>
    <text wx:if="{{currentRange}}" class="page-head__chip">{{currentRange}}</text>
  </view>

  <view class="hero">
    <view class="hero__stats">
      <view class="stat">
        <text class="stat__num stat__num--lime">{{periodTotal}}</text>
        <text class="stat__label">期食谱</text>
      </view>
      <view class="stat" bindtap="goGallery">
        <text class="stat__num stat__num--mint">{{dishTotal}}</text>
        <text class="stat__label">张配图</text>
      </view>
    </view>
    <image class="hero__mascot" src="/images/mascot.png" mode="aspectFit" />
  </view>

  <view wx:if="{{envError}}" class="alert alert--warn">{{envError}}</view>
  <view wx:if="{{dishImageError}}" class="alert alert--warn">{{dishImageError}}</view>

  <!-- 导入过的食谱：默认只露最近 3 期 -->
  <view class="sec-head">
    <text class="sec-head__title">导入过的食谱</text>
    <text wx:if="{{periodTotal}}" class="sec-head__count">共 {{periodTotal}} 期</text>
  </view>
  <view wx:if="{{!periodTotal}}" class="card">
    <view class="muted">还没有导入记录</view>
  </view>
  <block wx:else>
    <view
      wx:for="{{periodsShown}}"
      wx:key="_id"
      class="prow{{item.isCurrent ? ' prow--on' : ''}}"
      data-id="{{item._id}}"
      bindtap="onPeriodTap"
    >
      <text class="prow__text">{{item.rangeText}}</text>
      <view wx:if="{{item.badgeText}}" class="prow__badge{{item.isCurrent ? ' prow__badge--on' : ''}}">
        {{item.badgeText}}
      </view>
    </view>

    <view wx:if="{{periodTotal > periodPreview}}" class="btn-dark more" bindtap="togglePeriods">
      {{periodExpanded ? '收起，只看最近 ' + periodPreview + ' 期' : '展开全部（还有 ' + (periodTotal - periodPreview) + ' 期）'}}
    </view>
    <view wx:if="{{periodTruncated}}" class="muted more-note">
      仅显示最近 {{periodTotal}} 期，更早的已超出查询上限
    </view>
  </block>

  <!-- 食材处理手册：四色轮转 + 手风琴 -->
  <view class="sec-head sec-head--gap">
    <text class="sec-head__title">食材处理</text>
    <text class="sec-head__count">{{prep.groups.length}} 类</text>
  </view>
  <!-- 两层循环都必须显式命名 index，否则内层会覆盖外层的 index（必现 bug） -->
  <view
    wx:for="{{prep.groups}}"
    wx:for-index="gindex"
    wx:key="name"
    class="grow prow--t{{gindex % 4}} {{prepOpenIndex === gindex ? 'grow--open' : ''}}"
  >
    <view class="grow__head" data-index="{{gindex}}" bindtap="togglePrep">
      <text class="grow__name">{{item.name}}</text>
      <view class="grow__caret">{{prepOpenIndex === gindex ? '⌃' : '⌄'}}</view>
    </view>

    <view wx:if="{{prepOpenIndex === gindex}}" class="grow__steps">
      <view
        wx:for="{{item.steps}}"
        wx:for-item="step"
        wx:for-index="sindex"
        wx:key="no"
        class="gstep"
        data-gindex="{{gindex}}"
        data-sindex="{{sindex}}"
        bindlongpress="copyPrepStep"
      >
        <view class="gstep__hd">
          <text class="gstep__no">{{step.no}}</text>
          <text class="gstep__title">{{step.title}}</text>
        </view>
        <view class="gstep__text">{{step.text}}</view>
      </view>
    </view>
  </view>

  <view class="muted prep-source">来源：{{prep.source}}（{{prep.updatedAt}} 录入）</view>

  <!-- 小工具 -->
  <view class="tools">
    <button class="btn-ghost" bindtap="goImport">导入新食谱</button>
    <button class="btn-ghost" bindtap="clearCache">清除配图缓存</button>
  </view>
</view>