<!-- 今日页：品牌紫 hero 卡 + 两列菜品色卡 + 备料汇总条 -->
<view class="container container--tab">
  <view wx:if="{{loading}}" class="center-tip">正在开饭…</view>

  <view wx:elif="{{state === 'error'}}" class="card">
    <view class="card-title">出错了</view>
    <view class="muted">{{errMsg}}</view>
    <button class="btn-primary" style="margin-top:24rpx" bindtap="onErrorRetry">重试</button>
  </view>

  <block wx:elif="{{state === 'in-period'}}">
    <view class="page-head">
      <text class="page-head__title">今日</text>
      <view class="page-head__chip" bindtap="goImport">导入食谱</view>
    </view>

    <view wx:if="{{todayDay}}" class="hero">
      <view class="hero__main">
        <text class="hero__date">{{heroDate}}</text>
        <text class="hero__badge">今天</text>
      </view>
      <image class="hero__mascot" src="/images/mascot.png" mode="aspectFit" />
    </view>

    <view wx:if="{{tiles.length}}" class="sec-head">
      <text class="sec-head__title">今天的饭</text>
      <text class="sec-head__count">{{tiles.length}} 餐</text>
    </view>

    <view wx:if="{{tiles.length}}" class="grid">
      <dish-tile
        wx:for="{{tiles}}"
        wx:key="uid"
        class="grid__cell"
        meal="{{item}}"
        tone="{{index}}"
        image="{{item.imageUrl}}"
        expanded="{{expandedUid === item.uid}}"
        bind:dishtap="onTileTap"
      />
    </view>
    <view wx:elif="{{todayDay}}" class="card">
      <view class="muted">今天没有安排，看看本周其它日子吧</view>
    </view>

    <!-- 备料：早/晚各一张卡，整周备料只在周日出现。点卡进单日详情看完整步骤 -->
    <prep-card
      wx:if="{{morningPrep}}"
      title="{{morningPrep.title}}"
      timing="morning"
      items="{{morningPrep.items}}"
      bind:preptap="goPrep"
    />
    <prep-card
      wx:if="{{eveningPrep}}"
      title="{{eveningPrep.title}}"
      timing="evening"
      items="{{eveningPrep.items}}"
      bind:preptap="goPrep"
    />
    <prep-card
      wx:if="{{weeklyPrep}}"
      title="{{weeklyPrep.title}}"
      timing="weekly"
      items="{{weeklyPrep.items}}"
      bind:preptap="goPrep"
    />

    <view wx:if="{{tomorrowDay}}" class="sec-head sec-head--gap">
      <text class="sec-head__title">明天</text>
      <view class="sec-head__act" bindtap="goTomorrowDetail">详情</view>
    </view>
    <view wx:if="{{tomorrowDay}}" class="grid">
      <dish-tile
        wx:for="{{tomorrowTiles}}"
        wx:key="uid"
        class="grid__cell"
        meal="{{item}}"
        tone="{{index}}"
        image="{{item.imageUrl}}"
        bind:dishtap="onTileTap"
      />
    </view>
    <view wx:elif="{{todayDay}}" class="card muted">明天的安排还没导入</view>
  </block>

  <!-- 未开始 -->
  <block wx:elif="{{state === 'before'}}">
    <view class="page-head">
      <text class="page-head__title">今日</text>
      <view class="page-head__chip" bindtap="goImport">导入食谱</view>
    </view>
    <view class="card state-card">
      <view class="state-card__emoji">🍚</view>
      <view class="card-title">食谱已就绪，还没开饭</view>
      <view class="muted">{{beforeText}}（{{periodRange}}）</view>
      <button class="btn-primary" style="margin-top:28rpx" bindtap="goWeek">先看看这期菜单</button>
    </view>
  </block>

  <!-- 已结束 -->
  <block wx:elif="{{state === 'after'}}">
    <view class="page-head">
      <text class="page-head__title">今日</text>
    </view>
    <view class="card state-card">
      <view class="state-card__emoji">📭</view>
      <view class="card-title">这一期吃完了</view>
      <view class="muted">上一份食谱已结束（{{periodRange}}），把新一周的 Excel 导进来吧</view>
      <button class="btn-primary" style="margin-top:28rpx" bindtap="goImport">导入新食谱</button>
    </view>
  </block>
</view>