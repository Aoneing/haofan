/* 菜品详情页：全屏布局。
   图区不再包在 .card 里 —— 卡片有 24rpx 圆角和 32rpx 外边距，图会被「框」住，
   看着就不像全屏。现在图直接顶到屏幕左右边缘，内容面板浮在下方。 */
.dish {
  padding-bottom: 48rpx;
}

.dish__hero {
  position: relative;
  width: 750rpx;
  overflow: hidden;
  background: #f2ead9;
}
/* 底部渐变条：图是浅色时白字也要看得清，同时把菜名压在图上，节省竖向空间 */
.dish__hero-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 64rpx 32rpx 28rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.5));
}
.dish__hero-title {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}
.dish__hero-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.dish__panel {
  padding: 28rpx 32rpx 0;
}

/* 做法 */
.dish-sec {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(122, 96, 66, 0.06);
}
.dish-sec__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.dish-sec__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d332b;
}
.dish-sec__act {
  font-size: 24rpx;
  color: #b07a4a;
}
.dish-recipe {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4a3f33;
  word-break: break-word;
  white-space: pre-line; /* 做法里保留了 Excel 的换行，要原样断行 */
}
.dish-recipe--empty {
  font-size: 24rpx;
  color: #9a8f80;
}

.dish-gen {
  margin-top: 28rpx;
}
.dish-gen-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: #b07a4a;
}
.dish-key {
  margin-top: 12rpx;
  word-break: break-all;
}
.dish-note {
  margin-top: 20rpx;
}

/* ---- 诊断面板 ---- */
.dish-diag {
  margin-top: 28rpx;
  border-top: 1rpx solid #efe6d8;
  padding-top: 20rpx;
}
.dish-diag__toggle {
  font-size: 24rpx;
  color: #b07a4a;
  padding: 8rpx 0;
}
.dish-diag__body {
  margin-top: 12rpx;
  background: #fbf7f0;
  border: 1rpx solid #efe6d8;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: left;
}
.dish-diag__verdict {
  font-size: 26rpx;
  font-weight: 700;
  color: #8a5a1e;
  margin-bottom: 12rpx;
}
.dish-diag__line {
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b5c4a;
  word-break: break-all;
}
.dish-diag__hint {
  font-size: 22rpx;
  line-height: 1.7;
  color: #3d6b46;
  margin-top: 6rpx;
}
.dish-diag__line--copy {
  margin-top: 18rpx;
  color: #b07a4a;
  text-decoration: underline;
}
