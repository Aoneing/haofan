.dish-card {
  text-align: center;
  padding: 40rpx 32rpx;
}
.dish-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.dish-hero__tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9a8f80;
}
.dish-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3d332b;
}
.dish-key {
  margin-top: 8rpx;
  word-break: break-all;
}
.dish-note {
  margin-top: 20rpx;
  text-align: left;
}
.dish-gen-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b07a4a;
}
