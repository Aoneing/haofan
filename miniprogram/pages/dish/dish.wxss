/* 菜品详情页：全屏布局。
   图区不再包在 .card 里 —— 卡片有圆角和32rpx 外边距，图会被「框」住，
   看着就不像全屏。现在图直接顶到屏幕左右边缘，内容面板浮在下方。 */
.dish {
  padding-bottom: 48rpx;
}

.dish__hero {
  position: relative;
  width: 750rpx;
  overflow: hidden;
  background: #f2f2f4;
}
/* 白纱渐变：从图中部往下渐隐成页面白底，图与文字自然过渡（参考图同款），
   菜名压在已经变白的区域上，深字清晰可读，不需要黑条护字 */
.dish__veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.55) 42%,
    rgba(255, 255, 255, 0.92) 74%,
    #ffffff 100%
  );
}
/* 毛玻璃胶囊：浮在图上角，半透白 + 模糊，浅色图深色图都不抢戏 */
.dish__chip {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0e0e10;
  box-shadow: 0 4rpx 18rpx rgba(14, 14, 16, 0.1);
}
/* 菜名：大字居中落在渐变过渡区，页面主角；整体往上提一点，给做法区让出首屏 */
.dish__head {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 32rpx;
  padding: 0 44rpx;
  text-align: center;
}
.dish__title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 2rpx;
  color: #0e0e10;
}

/* 面板整体往上提：负 margin 让内容压进图底白区，首屏即可看全做法 */
.dish__panel {
  margin-top: -56rpx;
  padding: 24rpx 32rpx 0;
}

/* 做法 */
.dish-sec {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(59, 58, 174, 0.06);
}
.dish-sec__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.dish-sec__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0e0e10;
}
.dish-sec__act {
  font-size: 24rpx;
  font-weight: 600;
  color: #3b3aae;
}
.dish-recipe {
  font-size: 34rpx;
  line-height: 1.85;
  color: #1f3a3d;
  word-break: break-word;
  white-space: pre-line; /* 做法里保留了 Excel 的换行，要原样断行 */
}
.dish-recipe--empty {
  font-size: 24rpx;
  color: #8b8c93;
}

.dish-gen {
  margin-top: 28rpx;
}
.dish-gen-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: #3b3aae;
}
.dish-key {
  margin-top: 12rpx;
  word-break: break-all;
}
.dish-note {
  margin-top: 20rpx;
}

/* ---- 诊断面板 ---- */
.dish-diag {
  margin-top: 28rpx;
  border-top: 1rpx solid #e6e6ea;
  padding-top: 20rpx;
}
.dish-diag__toggle {
  font-size: 24rpx;
  color: #3b3aae;
  padding: 8rpx 0;
}
.dish-diag__body {
  margin-top: 12rpx;
  background: #f2f2f4;
  border-radius: 18rpx;
  padding: 22rpx;
  text-align: left;
}
.dish-diag__verdict {
  font-size: 26rpx;
  font-weight: 700;
  color: #3b3aae;
  margin-bottom: 12rpx;
}
.dish-diag__line {
  font-size: 22rpx;
  line-height: 1.7;
  color: #55565c;
  word-break: break-all;
}
.dish-diag__hint {
  font-size: 22rpx;
  line-height: 1.7;
  color: #1f3a3d;
  margin-top: 6rpx;
}
.dish-diag__line--copy {
  margin-top: 18rpx;
  color: #3b3aae;
  text-decoration: underline;
}