<view class="container">
  <view class="card dish-card">
    <view class="dish-hero" bindtap="preview">
      <dish-thumb title="{{title}}" url="{{url}}" size="{{420}}" />
      <view wx:if="{{url}}" class="dish-hero__tip">点击查看大图</view>
      <view wx:else class="dish-hero__tip">还没有配图，点击下方生成</view>
    </view>
    <view class="dish-title">{{title}}</view>
    <view class="muted dish-key">配图主键：{{key}}</view>
    <button
      class="btn-primary"
      style="margin-top:32rpx"
      loading="{{generating}}"
      bindtap="generate"
    >
      {{url ? '换一张配图' : '生成 AI 配图'}}
    </button>
    <view class="muted dish-note">
      配图按「归一化菜名」全库复用：同一个菜名在一周里出现多次，用的都是同一张图。
      生成的图片会存进云存储，下次直接复用。
    </view>
  </view>
</view>
