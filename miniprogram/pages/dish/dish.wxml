<!-- 菜品详情：全屏大图 + 毛玻璃渐变过渡 + 做法 + AI 生成入口
     布局要点：图区顶到屏幕左右边缘（满屏宽），底部用白纱渐变把图「融」进
     白色页面，菜名大字落在过渡区重点显示；图上浮毛玻璃胶囊提示状态。 -->
<view class="dish">
  <view class="dish__hero" style="height:{{heroH}}rpx" bindtap="preview">
    <dish-thumb
      title="{{title}}"
      url="{{url}}"
      imgkey="{{key}}"
      size="{{heroW}}"
      height="{{heroH}}"
      radius="{{0}}"
      bindimgerror="onThumbError"
    />
    <!-- 白纱渐变：图片下沿渐隐进页面白底，不再用黑色压字条 -->
    <view class="dish__veil"></view>
    <!-- 毛玻璃状态胶囊：浮在图上，像参考图的热量角标 -->
    <view class="dish__chip">{{url ? '点击查看大图' : '还没有配图，点击下方生成'}}</view>
    <!-- 菜名：落在渐变过渡区，大字重点显示 -->
    <view class="dish__head">
      <view class="dish__title">{{title}}</view>
    </view>
  </view>

  <view class="dish__panel">
    <!-- 做法：跳转进来时由 day 页带过来，不在这里重新查库 -->
    <view class="dish-sec">
      <view class="dish-sec__hd">
        <text class="dish-sec__title">做法</text>
        <text wx:if="{{hasRecipe}}" class="dish-sec__act" catchtap="copyRecipe">复制</text>
      </view>
      <view wx:if="{{hasRecipe}}" class="dish-recipe" bindlongpress="copyRecipe">{{recipe}}</view>
      <view wx:else class="dish-recipe dish-recipe--empty">这份食谱没有记录做法</view>
    </view>

    <button
      class="btn-primary dish-gen"
      loading="{{generating}}"
      disabled="{{generating}}"
      bindtap="generate"
    >
      {{generating ? '生成中…' : (url ? '换一张配图' : '生成 AI 配图')}}
    </button>
    <view wx:if="{{generating}}" class="dish-gen-tip">{{genTip}}</view>

    <view class="muted dish-note">
      配图按「归一化菜名」全库复用：同一个菜名在一周里出现多次，用的都是同一张图。
      生成的图片会存进云存储，下次直接复用。
    </view>
    <view class="muted dish-key">配图主键：{{key}}</view>
  </view>
</view>
