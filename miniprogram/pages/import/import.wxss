.steps {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 24rpx;
  font-size: 24rpx;
  color: #8b8c93;
}
.steps__item--on {
  color: #3b3aae;
  font-weight: 700;
}
.steps__arrow {
  margin: 0 16rpx;
}

.picked {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  background: #f2f2f4;
  border-radius: 18rpx;
  padding: 22rpx;
}
.picked__name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  word-break: break-all;
}

.period-line {
  font-size: 32rpx;
  font-weight: 700;
  color: #0e0e10;
  margin-bottom: 16rpx;
}

.check-line {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.check-line__warn {
  color: #b3261e;
  font-weight: 600;
}
.check-line__muted {
  color: #8b8c93;
}

.alert__code {
  font-weight: 700;
  margin-right: 8rpx;
}

.year-link {
  color: #3b3aae;
  text-decoration: underline;
  font-weight: 600;
}

.state-card {
  text-align: center;
  padding: 72rpx 40rpx;
}
.state-card__emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-card .muted {
  display: block;
}