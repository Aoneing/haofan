<view
  wx:if="{{vm}}"
  class="dc {{highlight === 'today' ? 'dc--today' : highlight === 'tomorrow' ? 'dc--tomorrow' : ''}} {{compact ? 'dc--compact' : ''}} {{expandable ? 'dc--expandable' : 'dc--static'}}"
>
  <view class="dc__head" catchtap="onTap">
    <text class="dc__date">{{vm.dateText}}</text>
    <text wx:if="{{highlight === 'today'}}" class="dc__badge dc__badge--today">今天</text>
    <text wx:elif="{{highlight === 'tomorrow'}}" class="dc__badge dc__badge--tomorrow">明天</text>
    <text wx:if="{{compact}}" class="dc__more">详情 ›</text>
  </view>

  <!-- 餐次 -->
  <view
    wx:for="{{vm.meals}}"
    wx:key="index"
    class="dc__meal {{expandable ? 'dc__meal--tap' : ''}} {{item.expanded ? 'dc__meal--open' : ''}}"
    style="background:{{item.bg}};color:{{item.fg}}"
    hover-class="{{expandable ? 'dc__meal--hover' : 'none'}}"
    hover-stay-time="80"
    data-index="{{index}}"
    catchtap="onMealTap"
  >
    <text class="dc__meal-label">{{item.mealText}}</text>

    <!-- 配图：首页默认不可见（0 宽淡出），点开后才淡入；图源后续阶段接入 -->
    <view
      class="dc__thumb"
      style="width:{{item.showThumb ? item.thumbSize : 0}}rpx;opacity:{{item.showThumb ? 1 : 0}};margin-right:{{item.showThumb ? 20 : 0}}rpx"
    >
      <dish-thumb title="{{item.title}}" url="{{item.imageUrl}}" imgkey="{{item.key}}" size="{{item.thumbSize}}" />
    </view>

    <view class="dc__meal-main">
      <view class="dc__dish-row">
        <text
          class="dc__dish {{item.missing ? 'dc__dish--missing' : ''}} {{item.bigTitle ? 'dc__dish--big' : ''}}"
          data-index="{{index}}"
          data-key="{{item.key}}"
          data-title="{{item.title}}"
          catchtap="onDishTap"
        >{{item.title}}</text>
        <text wx:if="{{item.needsReview}}" class="dc__tag">待校对</text>
        <text wx:if="{{expandable}}" class="dc__caret">▾</text>
      </view>
      <text wx:if="{{item.optionsText}}" class="dc__options">可选：{{item.optionsText}}</text>

      <!-- 展开区：做法 + 详情入口（首页默认收起） -->
      <view class="dc__expand {{item.showBody ? 'dc__expand--open' : ''}}">
        <text wx:if="{{item.recipe}}" class="dc__recipe">{{item.recipe}}</text>
        <view
          wx:if="{{expandable}}"
          class="dc__detail"
          data-key="{{item.key}}"
          data-title="{{item.title}}"
          catchtap="onDishDetail"
        >菜品详情 ›</view>
      </view>
    </view>
  </view>

  <!-- 按天备料 -->
  <view wx:if="{{vm.prepNotes.length}}" class="dc__prep">
    <view wx:for="{{vm.prepNotes}}" wx:key="index" class="dc__prep-item">
      <text class="dc__prep-timing dc__prep-timing--{{item.timing}}">{{item.timingText}}</text>
      <view class="dc__prep-body">
        <text class="dc__prep-label">{{item.label}}</text>
        <text wx:if="{{item.stepsText}}" class="dc__prep-steps">{{item.stepsText}}</text>
      </view>
    </view>
  </view>

  <!-- 整周备注 -->
  <view wx:if="{{vm.globalPrepList.length}}" class="dc__global">
    <view wx:for="{{vm.globalPrepList}}" wx:key="label" class="dc__global-item">
      <text class="dc__global-label">{{item.label}}</text>
      <text class="dc__global-value">{{item.value}}</text>
    </view>
  </view>
</view>
