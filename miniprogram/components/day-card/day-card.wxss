.dc {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(122, 96, 66, 0.06);
}
.dc--today {
  background: #fff7ea; /* 今天：极浅橙纯色底替代边框高亮（不压过餐次色块） */
  box-shadow: 0 8rpx 24rpx rgba(178, 106, 0, 0.14);
}
.dc--tomorrow {
  background: #fcf9f1; /* 明天：微暖白纯色底，与普通白卡区分 */
}

.dc__head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dc__date {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d332b;
}
.dc__badge {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.dc__badge--today {
  background: #b26a00;
  color: #ffffff;
}
.dc__badge--tomorrow {
  background: #f3e5c8;
  color: #854f0b;
}
.dc__more {
  margin-left: auto;
  color: #9a8f80;
  font-size: 24rpx;
}

/* 餐次块 */
.dc__meal {
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.dc__meal:last-of-type {
  margin-bottom: 0;
}
/* 可展开模式：整行可点，轻微按压缩反馈 + 展开时顶部对齐 */
.dc__meal--tap {
  transition: transform 0.12s ease, padding 0.26s ease;
}
.dc__meal--hover {
  transform: scale(0.985);
}
.dc__meal--open {
  align-items: flex-start;
  padding: 24rpx 20rpx;
}
.dc__meal-label {
  writing-mode: vertical-rl;
  text-orientation: upright;
  letter-spacing: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 20rpx;
  opacity: 0.85;
  flex-shrink: 0;
}

/* 配图区：首页默认收为 0 宽淡出，点开餐次后淡入（图源后续阶段接入） */
.dc__thumb {
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  transition: width 0.28s ease, opacity 0.24s ease, margin-right 0.28s ease;
}

.dc__meal-main {
  flex: 1;
  min-width: 0;
}
.dc__dish-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.dc__dish {
  font-size: 30rpx;
  font-weight: 600;
  transition: font-size 0.24s ease;
}
.dc__dish--big {
  font-size: 38rpx;
}
.dc__dish--missing {
  color: inherit;
  opacity: 0.45;
  font-weight: 400;
}
.dc__tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.65);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
/* 展开指示箭头（仅可展开模式） */
.dc__caret {
  margin-left: auto;
  padding-left: 16rpx;
  font-size: 26rpx;
  line-height: 1;
  opacity: 0.5;
  flex-shrink: 0;
  transition: transform 0.28s ease;
}
.dc__meal--open .dc__caret {
  transform: rotate(180deg);
}
.dc__options {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* 静态紧凑模式（未开 expandable 的紧凑卡片）：不展示做法，维持原有紧凑观感
   注：周视图已改用可展开模式，此规则仅兜底，避免与展开动画冲突 */
.dc--static.dc--compact .dc__expand {
  display: none;
}

/* 展开区（做法 + 详情入口）：仅可展开模式下限制高度并做过渡 */
.dc--expandable .dc__expand {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  margin-top: 0;
  transition: max-height 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.28s ease,
    margin-top 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.dc--expandable .dc__expand--open {
  max-height: 900rpx;
  opacity: 1;
  margin-top: 10rpx;
}
.dc__recipe {
  display: block;
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 6rpx;
  white-space: pre-line;
}
.dc__detail {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
}

/* 备料：浅米色块替代分割线 */
.dc__prep {
  margin-top: 20rpx;
  background: #faf5ea;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.dc__prep-item {
  display: flex;
  margin-bottom: 12rpx;
}
.dc__prep-item:last-child {
  margin-bottom: 0;
}
.dc__prep-timing {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-top: 4rpx;
}
.dc__prep-timing--morning {
  background: #faeeda;
  color: #854f0b;
}
.dc__prep-timing--evening {
  background: #e6f1fb;
  color: #0c447c;
}
.dc__prep-timing--unknown {
  background: #f3eee5;
  color: #7a6a55;
}
.dc__prep-body {
  flex: 1;
  min-width: 0;
}
.dc__prep-label {
  display: block;
  font-size: 24rpx;
  color: #7a6a55;
  font-weight: 600;
}
.dc__prep-steps {
  display: block;
  font-size: 24rpx;
  color: #9a8f80;
}

/* 整周备注 */
.dc__global {
  margin-top: 16rpx;
}
.dc__global-item {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}
.dc__global-label {
  color: #b26a00;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.dc__global-value {
  color: #7a6a55;
  flex: 1;
  min-width: 0;
}
