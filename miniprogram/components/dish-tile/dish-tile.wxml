<!-- dish-tile — 菜品色卡
     顶部 AI 插图（底边渐融入卡片底色）+ 餐次标签 + 菜名 + 底部小字热量/用时。
     底色由 tone 决定（四色轮转），文字色由 tone 自带的高/低对比前景色决定，
     不在组件里判断「深底配白字」—— 那是配色表的事，混进来就会出现某一张卡看不清。 -->
<view
  wx:if="{{vm}}"
  class="dt {{vm.missing ? 'dt--missing' : ''}} {{vm.main ? 'dt--main' : ''}}"
  style="background:{{vm.bg}};color:{{vm.fg}}"
  hover-class="dt--hover"
  hover-stay-time="80"
  data-index="{{index}}"
  data-key="{{vm.key}}"
  data-title="{{vm.title}}"
  data-recipe="{{vm.recipe}}"
  bindtap="onTap"
>
  <!-- 插图：顶满卡片，底边加渐变条融入卡片底色，避免硬矩形边 -->
  <view wx:if="{{vm.image}}" class="dt__media">
    <image class="dt__img" src="{{vm.image}}" mode="aspectFill" lazy-load="true" />
    <view class="dt__fade" style="background:linear-gradient(to bottom, rgba(255,255,255,0), {{vm.bg}});" />
  </view>

  <view wx:if="{{vm.mealLabel}}" class="dt__meal {{vm.main ? 'dt__meal--main' : ''}}">{{vm.mealLabel}}</view>

  <view class="dt__head">
    <text class="dt__title">{{vm.title}}</text>
    <view class="dt__menu" catchtap="onMenu">
      <view class="dt__dot" />
      <view class="dt__dot" />
      <view class="dt__dot" />
    </view>
  </view>

  <!-- 展开的详情：做法要点 + 跳转入口。默认收起 -->
  <view class="dt__more {{vm.expanded ? 'dt__more--open' : ''}}">
    <text wx:if="{{vm.recipe}}" class="dt__recipe">{{vm.recipe}}</text>
    <view class="dt__link" catchtap="onDetail">菜品详情 ›</view>
  </view>

  <!-- 底部小字：热量 + 用时 -->
  <view wx:if="{{!vm.missing}}" class="dt__foot">
    <view class="dt__foot-item">
      <view class="dt__ico dt__ico--drop" />
      <text class="dt__foot-num">{{vm.kcalText}}</text>
    </view>
    <view class="dt__foot-item">
      <view class="dt__ico dt__ico--clock" />
      <text class="dt__foot-num">{{vm.minutesText}}</text>
    </view>
  </view>
</view>