.dt {
  border-radius: 32rpx;
  padding: 26rpx 26rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  /* 宿主（dish-tile 标签）在网格里是纵向 flex：同行等高时
     由这里撑满宿主高度，矮卡不再在卡下留空白 */
  flex: 1;
}
.dt--hover {
  opacity: 0.86;
}
/* 主餐（午餐/晚餐）：立体阴影把它从网格里抬起来，一眼就是重点。
   底色在 JS 里已换成 bgStrong（加深版），这里只加阴影，不抢边框语言 */
.dt--main {
  box-shadow: 0 8rpx 26rpx rgba(59, 58, 174, 0.20);
}

/* 餐次标签：右上不抢菜名，用描边小胶囊。颜色随色卡前景色走，
   所以黄/浅紫/深绿/深紫四种底上都看得清，不依赖组件判断深底浅底 */
.dt__meal {
  align-self: flex-start;
  margin-bottom: 14rpx;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  border-radius: 999rpx;
  border: 1.5rpx solid currentColor;
  opacity: 0.78;
}
/* 主餐徽标：实心品牌紫底 + 白字，比描边小胶囊醒目得多，
   配角仍是描边款，两张卡一对比主次立刻出来 */
.dt__meal--main {
  background: #3b3aae;
  color: #ffffff;
  border: none;
  opacity: 1;
  font-weight: 700;
}

.dt__head {
  display: flex;
  align-items: flex-start;
}
.dt__title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}
/* 未安排的格子：整块淡出，不要占住视觉重心 */
.dt--missing {
  opacity: 0.45;
}
.dt--missing .dt__title {
  font-weight: 400;
}

/* 「⋮」：纯装饰，点它等同于点整张卡 */
.dt__menu {
  flex-shrink: 0;
  margin-left: 12rpx;
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.dt__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.85;
}

.dt__ico {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
  opacity: 0.9;
}
/* 热量：水滴 —— 用 CSS 画，避免为两个小图标再引入图片资源 */
.dt__ico--drop {
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  border: 3rpx solid currentColor;
}
/* 用时：钟面 —— 圆环 + 指针 */
.dt__ico--clock {
  border-radius: 50%;
  border: 3rpx solid currentColor;
}
.dt__ico--clock::after {
  content: '';
  display: block;
  width: 3rpx;
  height: 8rpx;
  margin: 3rpx auto 0;
  background: currentColor;
}

/* 顶部插图：顶满卡片，负 margin 出血到圆角边缘；overflow 兜底裁掉方角 */
.dt__media {
  position: relative;
  margin: -26rpx -26rpx 18rpx;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  height: 210rpx;
}
.dt__img {
  width: 100%;
  height: 100%;
  display: block;
}
/* 底边渐变条：从透明过渡到卡片底色，把插图下边缘「化」进卡片，无硬矩形边 */
.dt__fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  pointer-events: none;
}

/* 底部小字：热量 + 用时。margin-top:auto 把它压到卡片最底——
   等高拉伸后矮卡多出的空间留在标题和底部小字之间，卡面仍是完整色块 */
.dt__foot {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: auto;
  padding-top: 16rpx;
}
.dt__foot-item {
  display: flex;
  align-items: center;
}
.dt__foot-num {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.dt__more {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.34s ease, opacity 0.24s ease, margin-top 0.34s ease;
}
.dt__more--open {
  max-height: 500rpx;
  opacity: 0.86;
  margin-top: 18rpx;
}
.dt__recipe {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  white-space: pre-line;
}
.dt__link {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 23rpx;
  font-weight: 600;
  opacity: 0.9;
}