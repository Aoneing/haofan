<view
  class="thumb {{src ? 'thumb--img' : 'thumb--ph'}}"
  style="width:{{size}}rpx;height:{{height > 0 ? height : size}}rpx;border-radius:{{radius}}rpx"
>
  <image
    wx:if="{{src}}"
    class="thumb__img"
    src="{{src}}"
    mode="aspectFill"
    lazy-load="{{true}}"
    binderror="onImgError"
  />
  <text wx:else class="thumb__ph" style="font-size:{{phSize}}rpx">{{phChar}}</text>
</view>
