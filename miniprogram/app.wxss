/* app.wxss — 全局设计 token 与基础件
 *
 * 配色取自 docs/UI参考 三张定稿图的像素采样：
 *   品牌紫 #3B3AAE（hero 卡）· 柠檬黄 #E9F94E（强调）· 浅紫 #A9B6F2
 *   中紫 #7C8CD8 · 深墨绿 #1F3A3D · 浅灰 #F2F2F4 · 薄荷 #7FE3C4
 *
 * 与上一版的差别：原来是「暖米色 + 橙棕」，饱和度低、明度接近，
 * 色块之间读不出主次；现在改成高明度大色块，靠明度差拉开层级。 */

page {
  background: #ffffff;
  color: #0e0e10;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ---------- token ---------- */
page,
.container {
  --brand: #3b3aae; /* 品牌紫 */
  --brand-deep: #2a297f; /* 深一档，hover / 描边 */
  --lime: #e9f94e; /* 柠檬黄 */
  --violet-1: #a9b6f2; /* 浅紫 */
  --violet-2: #7c8cd8; /* 中紫 */
  --forest: #1f3a3d; /* 深墨绿 */
  --mint: #7fe3c4; /* 薄荷 */
  --mist: #f2f2f4; /* 浅灰底 */
  --ink: #0e0e10; /* 主文 */
  --ink-2: #55565c; /* 次要文 */
  --ink-3: #8b8c93; /* 弱化文 */
  --hair: #e6e6ea; /* 分割线 */
}

.container {
  padding: 24rpx 32rpx 48rpx;
}

/* 四个 tab 页专用：自定义 tabBar 是 fixed 悬浮层，会压住页面底部内容。
   底部多留出「tabBar 高度（116rpx）+ 底距（20rpx）+ 呼吸空间」的补白，
   内容才能完整滚出 tabBar，页面也才有向上滑动的余地。 */
.container--tab {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

/* ---------- 页面大标题（「好饭 · 今日」这一行） ---------- */
.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 28rpx;
}
.page-head__title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: #0e0e10;
}
/* 标题右侧的圆角 chip（周期区间 / 导入食谱入口） */
.page-head__chip {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #0e0e10;
  background: #f2f2f4;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}
.page-head__chip:active {
  opacity: 0.6;
}

/* ---------- 区块标题（「今天的饭」+ 右侧计数） ---------- */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 8rpx 20rpx;
}
.sec-head__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0e0e10;
}
.sec-head__count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #55565c;
  background: #f2f2f4;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.sec-head__act {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #55565c;
  background: #f2f2f4;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.sec-head__act:active {
  opacity: 0.6;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(59, 58, 174, 0.06);
}
.card--flat {
  box-shadow: none;
  background: #f2f2f4;
}
.card--mist {
  box-shadow: none;
  background: #f2f2f4;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0e0e10;
  margin-bottom: 16rpx;
}

/* 弱化文字 */
.muted {
  color: #8b8c93;
  font-size: 24rpx;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: #3b3aae;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 8rpx 0;
}
.btn-primary[disabled] {
  background: #c9c9d8;
  color: #f2f2f4;
}

.btn-ghost {
  background: #f2f2f4;
  color: #0e0e10;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 8rpx 0;
}
.btn-ghost:active {
  opacity: 0.6;
}

/* 深色实底按钮（「展开全部」这类强调动作） */
.btn-dark {
  background: #1f3a3d;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
}
.btn-dark:active {
  opacity: 0.85;
}

/* ---------- 告警条 ---------- */
.alert {
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.alert--error {
  background: #fdeceb;
  color: #b3261e;
}
.alert--warn {
  background: #fff7d6;
  color: #7a5b00;
}
.alert--info {
  background: #eef0fb;
  color: #3b3aae;
}
.alert__code {
  font-weight: 700;
}

/* ---------- 状态页 ---------- */
.center-tip {
  text-align: center;
  color: #8b8c93;
  padding: 120rpx 0;
  font-size: 26rpx;
}
.state-card {
  text-align: center;
  padding: 72rpx 40rpx;
}
.state-card__emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.state-card .muted {
  display: block;
}

/* ---------- 两列卡片网格：同行等高铺满 ----------
 * 根因：dish-tile 有无 AI 插图高度差 210rpx，flex 换行布局里
 * 矮卡下方会露出一片空白。修法：flex 行内默认 stretch，让每个
 * 格子拉到同行最高；格子作为 flex 容器，dish-tile 宿主纵向撑满，
 * 卡片 .dt（组件内 flex:1）再撑满宿主 → 同行两卡永远等高。
 * 今日/一周/单日三页共用 .grid/.grid__cell，这里全局声明一次。 */
.grid__cell {
  display: flex;
}
dish-tile {
  display: flex;
  flex-direction: column;
  min-width: 0;
}